# ==============================================================================
# MAXIM FORGE — Environment Variables Example
# ==============================================================================

# Database Connection (Optional — defaults to in-memory PostgreSQL if unconfigured)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Authentication (Refer to firebase-applet-config.json)
FIREBASE_API_KEY=
